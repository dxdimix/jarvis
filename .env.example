# このファイルを .env.local にコピーして値を入れる（.env.local はリポジトリに入らない）。
# 値は Supabase の管理画面 > Project Settings > API Keys / Data API で確認する。

# 画面（Next.js）用。ブラウザに公開されてよい値。Vercel の Environment Variables にも同じ値を入れる。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# PC 常駐プログラム（npm run agent）用。secret キーは強い権限を持つため、PC の .env.local にだけ置く。
# Vercel には入れない。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 任意（省略時の値）
# CLAUDE_MODEL=sonnet
# CLAUDE_BIN=claude
# JARVIS_TOOLS=WebSearch
# JARVIS_TIMEOUT_MS=180000
# JARVIS_MAX_TURNS=40
# JARVIS_AUTO_UPDATE=on
# JARVIS_UPDATE_INTERVAL_MS=3600000

# ジャービスが状況を読むアプリ（読み取り専用。PC の .env.local にだけ書く）
# <名前> は英字。ジャービスへの質問では「fx」「kabu」などの名前で呼ぶ。
# URL とキーは、そのアプリの Supabase の Project Settings（Data API / API Keys）で確認する。
# JARVIS_APP_FX_URL=https://xxxxxxxxxxxx.supabase.co
# JARVIS_APP_FX_KEY=sb_secret_xxxxxxxx
# JARVIS_APP_FX_LABEL=FX シグナル監視
# JARVIS_APP_KABU_URL=https://xxxxxxxxxxxx.supabase.co
# JARVIS_APP_KABU_KEY=sb_secret_xxxxxxxx
# JARVIS_APP_KABU_LABEL=株シグナル監視
# JARVIS_DEV_DIR=C:\Users\sike1\dev
